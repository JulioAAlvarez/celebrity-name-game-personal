// ============================================
// schema.prisma — Database Schema (Solo Version)
// ============================================
// This file defines the database models for the Celebrity Name Chain game.
// Players type their own names — no celebrity database is needed.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// GAME MODEL
// ============================================
// A game room that players can join.
// - roomCode: Unique code for players to join (e.g., "TEST01")
// - currentName: The current celebrity name in the chain (set by players)
// - hasStarted: Whether the game has started (host controls this)
// - players: List of players in the game
model Game {
  id          String   @id @default(cuid())
  roomCode    String   @unique
  currentName String?   // Set by the starting player or by the first correct guess
  hasStarted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players Player[]
}

// ============================================
// PLAYER MODEL
// ============================================
// A player participating in a game.
// - username: The player's chosen name (must be unique per game)
// - score: The player's total points
// - isHost: Whether this player is the host (can start the game)
// - isReady: Whether the player is ready to start (for lobby)
// - game: The game this player belongs to
model Player {
  id        String   @id @default(cuid())
  username  String
  score     Int      @default(0)
  isHost    Boolean  @default(false)
  isReady   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  // A player cannot have the same username twice in the same game
  @@unique([gameId, username])
}